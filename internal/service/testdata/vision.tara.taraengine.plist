<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>vision.tara.taraengine</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/taraengine</string>
		<string>serve</string>
		<string>--service</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>PathState</key>
		<dict>
			<key>/opt/homebrew/bin/taraengine</key>
			<true/>
		</dict>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/someone/Library/Logs/taraengine/service.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/someone/Library/Logs/taraengine/service.log</string>
</dict>
</plist>
